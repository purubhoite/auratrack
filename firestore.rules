rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function owns(data) {
      return signedIn() && data.userId == request.auth.uid;
    }
    function validName(name) {
      return name is string && name.size() > 0 && name.size() <= 80;
    }
    function validNote(note) {
      return note is string && note.size() <= 10000;
    }
    function ownsHabit(habitId) {
      return habitId is string &&
        exists(/databases/$(database)/documents/habits/$(habitId)) &&
        get(/databases/$(database)/documents/habits/$(habitId)).data.userId == request.auth.uid;
    }

    // Import markers are scoped to a user and created atomically alongside the
    // corresponding record. Immutable markers make retries non-destructive.
    match /users/{uid}/imports/{importId} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid &&
        request.resource.data.keys().hasAll(['habitId', 'createdAt']) &&
        request.resource.data.keys().hasOnly(['habitId', 'createdAt']) &&
        request.resource.data.habitId is string && request.resource.data.createdAt == request.time &&
        getAfter(/databases/$(database)/documents/habits/$(request.resource.data.habitId)).data.userId == uid;
      allow update, delete: if false;

      match /completions/{dateKey} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow create: if signedIn() && request.auth.uid == uid &&
          dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
          request.resource.data.keys().hasAll(['completionId', 'createdAt']) &&
          request.resource.data.keys().hasOnly(['completionId', 'createdAt']) &&
          request.resource.data.completionId is string && request.resource.data.createdAt == request.time &&
          getAfter(/databases/$(database)/documents/completions/$(request.resource.data.completionId)).data.userId == uid &&
          getAfter(/databases/$(database)/documents/completions/$(request.resource.data.completionId)).data.habitId ==
            get(/databases/$(database)/documents/users/$(uid)/imports/$(importId)).data.habitId;
        allow update, delete: if false;
      }
    }

    match /habits/{habitId} {
      allow read: if owns(resource.data);
      allow create: if owns(request.resource.data) &&
        request.resource.data.keys().hasAll(['name', 'userId', 'createdAt']) &&
        request.resource.data.keys().hasOnly(['name', 'userId', 'createdAt']) &&
        validName(request.resource.data.name) &&
        request.resource.data.createdAt == request.time;
      // Existing records can be renamed even if they contain legacy fields.
      allow update: if owns(resource.data) && owns(request.resource.data) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name']) &&
        validName(request.resource.data.name);
      allow delete: if owns(resource.data);
    }

    match /completions/{completionId} {
      allow read: if owns(resource.data);
      allow create: if owns(request.resource.data) &&
        request.resource.data.keys().hasAll(['userId', 'habitId', 'date', 'note']) &&
        request.resource.data.keys().hasOnly(['userId', 'habitId', 'date', 'note']) &&
        request.resource.data.date is timestamp && validNote(request.resource.data.note) &&
        ownsHabit(request.resource.data.habitId);
      allow update: if owns(resource.data) && owns(request.resource.data) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['note']) &&
        validNote(request.resource.data.note);
      // Allow owners to clean up completions even when the parent was already deleted.
      allow delete: if owns(resource.data);
    }
  }
}
